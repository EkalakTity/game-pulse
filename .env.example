# ─── Application ─────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://gamepulse:secret@localhost:5432/gamepulse_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string
NEXTAUTH_URL=http://localhost:3000

# ─── Token Encryption ─────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of social tokens
TOKEN_ENCRYPTION_KEY=change-me-to-a-random-64-hex-chars

# ─── Media / Cloudinary ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── Social Platforms ─────────────────────────────────────
# Facebook / Instagram (Meta Graph API)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ─── Worker Config ────────────────────────────────────────
INGEST_WORKER_CONCURRENCY=5
PUBLISH_WORKER_CONCURRENCY=2
MEDIA_WORKER_CONCURRENCY=10
BULL_BOARD_PORT=3001

# ─── Bull Board (web) ─────────────────────────────────────
NEXT_PUBLIC_BULL_BOARD_URL=http://localhost:3001/queues

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info

# ─── Future: AI ───────────────────────────────────────────
# ANTHROPIC_API_KEY=your-anthropic-api-key
